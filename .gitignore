*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
# These come from the standard Python template and name setuptools build
# output. Left unanchored they also match any directory of ours with the same
# name, anywhere in the tree — `publishing/lib/` holds the publishing scripts
# and `dist/` would match a publishing output directory. Anchor them to the
# repository root, which is the only place setuptools ever writes them.
/dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#   Usually these files are written by a python script from a template
#   before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

